# Defaults run locally without cloud credentials. Never use real family data.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./suzanne.db
COOKIE_SECURE=false
NEXT_TELEMETRY_DISABLED=1

# OpenRouter pilot: no paid call until BOTH server and household authorize it.
# Keep keys in .env (gitignored); never NEXT_PUBLIC_*.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROVIDER=
# Set true only after configuring the dedicated key/account spend cap on OpenRouter.
OPENROUTER_ACCOUNT_CAP_CONFIRMED=false
