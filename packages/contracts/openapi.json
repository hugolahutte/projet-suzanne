  "components": {
    "schemas": {
      "GoalUpdate": {
        "properties": {
          "done": {
            "type": "boolean",
            "title": "Done"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "done"
        ],
        "title": "GoalUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LiveUpdate": {
