        ],
        "title": "LiveUpdate"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "NewEntry": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "book",
              "grade",
              "homework"
            ],
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "subject": {
            "type": "string",
            "maxLength": 60,
            "title": "Subject",
            "default": ""
          },
          "details": {
            "type": "string",
            "maxLength": 2000,
            "title": "Details",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "title"
        ],
        "title": "NewEntry"
      },
      "NewGoal": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "NewGoal"
      },
      "ProfileUpdate": {
        "properties": {
          "nickname": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Nickname"
          },
          "large_text": {
            "type": "boolean",
            "title": "Large Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nickname",
          "large_text"
        ],
        "title": "ProfileUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
